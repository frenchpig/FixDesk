generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  TECHNICIAN
  ADMIN
}

enum TicketCategory {
  HARDWARE
  NETWORK
  INFRASTRUCTURE
  ELECTRICAL
}

/** Rol semántico estable de un estado (reportería/SLA no dependen de keys). */
enum StatusSemantic {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CANCELLED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

/** Impacto del incidente (distinto de prioridad operativa). */
enum TicketSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HistoryEventType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  NOTE_ADDED
  PHOTO_ADDED
  UPDATED
}

enum NotificationType {
  STATUS_CHANGED
  ASSIGNED
  NOTE_ADDED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(USER)
  areaId       String?
  area         Area?    @relation(fields: [areaId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reportedTickets Ticket[]        @relation("Reporter")
  assignedTickets Ticket[]        @relation("Assignee")
  historyEntries  TicketHistory[]
  notifications   Notification[]
  settingsUpdates SystemSettings[]

  @@index([role])
  @@index([areaId])
}

model Area {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  technicians User[]
  tickets     Ticket[]
}

model Ticket {
  id          String         @id @default(cuid())
  title       String
  description String
  category    TicketCategory
  status      String         @default("OPEN")
  priority    TicketPriority @default(MEDIUM)
  severity    TicketSeverity @default(MEDIUM)
  location    String
  photoUrl    String?

  reporterId String
  reporter   User   @relation("Reporter", fields: [reporterId], references: [id])

  assigneeId String?
  assignee   User?  @relation("Assignee", fields: [assigneeId], references: [id])

  areaId String?
  area   Area?  @relation(fields: [areaId], references: [id])

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  history       TicketHistory[]
  notifications Notification[]
  labels        Label[]

  @@index([status])
  @@index([priority])
  @@index([severity])
  @@index([category])
  @@index([reporterId])
  @@index([assigneeId])
  @@index([createdAt])
  @@index([status, priority])
  @@index([status, severity])
}

model Label {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String   @default("#64748B")
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model TicketHistory {
  id        String           @id @default(cuid())
  ticketId  String
  ticket    Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  eventType HistoryEventType
  oldStatus String?
  newStatus String?
  note      String?
  metadata  Json?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  ticketId  String?
  ticket    Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

/** Configuración global del sistema (singleton id = "default"). */
model SystemSettings {
  id                   String   @id
  slaTargetHours       Int      @default(48)
  /// Exigir nota al salir de un estado finalizado (reapertura).
  workflowNoteOnReopen Boolean  @default(true)
  updatedAt            DateTime @updatedAt
  updatedById          String?
  updatedBy            User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

/** Estado del workflow de tickets (editable por admin). */
model WorkflowState {
  id                  String         @id @default(cuid())
  key                 String         @unique
  label               String
  badgeVariant        String         @default("default")
  semantic            StatusSemantic
  finalized           Boolean        @default(false)
  kanban              Boolean        @default(true)
  noteRequiredOnEnter Boolean        @default(false)
  isDefault           Boolean        @default(false)
  isActive            Boolean        @default(true)
  order               Int            @default(0)
  /// Keys de estados destino permitidos.
  allowedTargets      String[]

  @@index([isActive, order])
}
